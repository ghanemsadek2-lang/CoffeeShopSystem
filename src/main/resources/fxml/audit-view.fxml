<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.AuditController" minWidth="0" minHeight="0" spacing="12" styleClass="module-root">
 <fx:define><TableView fx:id="resize" fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></fx:define>
 <Label styleClass="module-heading" text="Audit Log"/><Label styleClass="module-subheading" maxWidth="Infinity" wrapText="true" text="Review immutable security and operational activity recorded by the application."/>
 <FlowPane hgap="8" vgap="8"><TextField fx:id="searchField" prefWidth="240" promptText="Search action, entity, user or details"/><Label text="From"/><DatePicker fx:id="fromDate"/><Label text="To"/><DatePicker fx:id="toDate"/><Button onAction="#refresh" styleClass="primary-action" text="Refresh"/></FlowPane>
 <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true"/>
 <GridPane hgap="12" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columnConstraints><ColumnConstraints percentWidth="70" hgrow="ALWAYS" minWidth="0"/><ColumnConstraints percentWidth="30" hgrow="ALWAYS" minWidth="0"/></columnConstraints><children>
  <TableView fx:id="auditTable" columnResizePolicy="$resize" minWidth="0" minHeight="0" GridPane.hgrow="ALWAYS"><placeholder><VBox styleClass="empty-state"><Label styleClass="empty-state-title" text="No audit activity found"/><Label styleClass="empty-state-copy" text="Adjust the search or date range to review recorded activity." wrapText="true"/></VBox></placeholder><columns><TableColumn fx:id="timeColumn" prefWidth="170" text="Occurred"/><TableColumn fx:id="userColumn" prefWidth="120" text="User"/><TableColumn fx:id="actionColumn" prefWidth="170" text="Action"/><TableColumn fx:id="entityColumn" prefWidth="160" text="Entity"/><TableColumn fx:id="detailsColumn" prefWidth="300" text="Details"/></columns></TableView>
  <VBox minWidth="0" minHeight="0" spacing="7" styleClass="panel-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"><Label styleClass="panel-title" text="Event details"/><TextArea fx:id="detailArea" editable="false" minWidth="0" minHeight="0" wrapText="true" VBox.vgrow="ALWAYS"/></VBox>
 </children></GridPane>
 <padding><Insets bottom="18" left="18" right="18" top="18"/></padding>
</VBox>
