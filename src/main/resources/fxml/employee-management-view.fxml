<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.EmployeeManagementController" minWidth="0" minHeight="0" spacing="12" styleClass="module-root"><fx:define><TableView fx:id="resize" fx:constant="CONSTRAINED_RESIZE_POLICY"/></fx:define><Label styleClass="module-heading" text="Employees / Users"/><FlowPane hgap="8" vgap="8"><TextField fx:id="searchField" prefWidth="260" promptText="Search employee, number or username"/><Button onAction="#add" styleClass="primary-action" text="Add employee"/><Button fx:id="editButton" disable="true" onAction="#edit" text="Edit"/><Button fx:id="accountButton" disable="true" onAction="#account" text="User account"/><Button fx:id="activeButton" disable="true" onAction="#toggle" text="Deactivate"/><Button onAction="#refresh" text="Refresh"/></FlowPane><Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true"/><TableView fx:id="employeeTable" columnResizePolicy="$resize" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="numberColumn" prefWidth="110" text="Employee"/><TableColumn fx:id="nameColumn" prefWidth="170" text="Name"/><TableColumn fx:id="titleColumn" prefWidth="130" text="Job title"/><TableColumn fx:id="statusColumn" prefWidth="110" text="Employment"/><TableColumn fx:id="userColumn" prefWidth="130" text="Username"/><TableColumn fx:id="rolesColumn" prefWidth="150" text="Roles"/><TableColumn fx:id="activeColumn" prefWidth="90" text="Status"/></columns></TableView><padding><Insets bottom="18" left="18" right="18" top="18"/></padding></VBox>
