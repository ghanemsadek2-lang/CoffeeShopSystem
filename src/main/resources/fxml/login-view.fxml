<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>

<GridPane xmlns="http://javafx.com/javafx/21"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.coffeeshop.controller.LoginController"
          styleClass="login-root">
    <columnConstraints>
        <ColumnConstraints percentWidth="43.0" />
        <ColumnConstraints percentWidth="57.0" />
    </columnConstraints>

    <StackPane GridPane.columnIndex="0" styleClass="brand-panel">
        <VBox alignment="CENTER_LEFT" maxWidth="360.0" spacing="26.0" StackPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane minHeight="48.0" minWidth="48.0" prefHeight="48.0" prefWidth="48.0"
                           styleClass="brand-mark">
                    <Label styleClass="brand-mark-text" text="C" />
                </StackPane>
                <VBox spacing="1.0">
                    <Label styleClass="brand-name" text="COFFEE SHOP" />
                    <Label styleClass="brand-product" text="POS &amp; MANAGEMENT" />
                </VBox>
            </HBox>

            <StackPane minHeight="210.0" prefHeight="210.0" styleClass="coffee-art">
                <Circle radius="76.0" styleClass="coffee-art-halo" />
                <Arc length="260.0" radiusX="50.0" radiusY="40.0" startAngle="140.0"
                     styleClass="coffee-cup" />
                <Line endX="-10.0" endY="-24.0" startX="-20.0" startY="-48.0"
                      styleClass="steam-line" translateX="-10.0" />
                <Line endX="10.0" endY="-24.0" startX="20.0" startY="-48.0"
                      styleClass="steam-line" translateX="10.0" />
            </StackPane>

            <VBox spacing="10.0">
                <Label styleClass="brand-headline" text="Craft every service moment." wrapText="true" />
                <Label styleClass="brand-tagline"
                       text="Secure access to your coffee shop operations, built for calm and confident service."
                       wrapText="true" />
            </VBox>
        </VBox>
        <padding>
            <Insets bottom="48.0" left="54.0" right="54.0" top="48.0" />
        </padding>
    </StackPane>

    <StackPane GridPane.columnIndex="1" styleClass="form-panel">
        <VBox maxWidth="430.0" spacing="22.0" styleClass="login-card">
            <VBox spacing="7.0">
                <Label styleClass="eyebrow" text="SECURE ACCESS" />
                <Label styleClass="welcome-title" text="Welcome back" />
                <Label styleClass="welcome-copy"
                       text="Sign in to continue to Coffee Shop Management."
                       wrapText="true" />
            </VBox>

            <VBox spacing="9.0">
                <Label styleClass="field-label" text="Username" />
                <TextField fx:id="usernameField" accessibleText="Username"
                           promptText="Enter your username" styleClass="login-field" />
            </VBox>

            <VBox spacing="9.0">
                <Label styleClass="field-label" text="Password" />
                <StackPane fx:id="passwordContainer">
                    <PasswordField fx:id="passwordField" accessibleText="Password"
                                   onAction="#signIn" promptText="Enter your password"
                                   styleClass="login-field" />
                    <TextField fx:id="visiblePasswordField" accessibleText="Visible password"
                               managed="false" onAction="#signIn"
                               promptText="Enter your password" styleClass="login-field" visible="false" />
                </StackPane>
                <CheckBox fx:id="showPasswordCheckBox" mnemonicParsing="false"
                          styleClass="show-password" text="Show password" />
            </VBox>

            <Label fx:id="statusLabel" minHeight="42.0" styleClass="status-message" wrapText="true" />

            <Button fx:id="signInButton" defaultButton="true" maxWidth="Infinity"
                    mnemonicParsing="false" onAction="#signIn"
                    styleClass="sign-in-button" text="Sign In" />

            <HBox alignment="CENTER" minHeight="28.0" spacing="10.0">
                <ProgressIndicator fx:id="progressIndicator" managed="false"
                                   maxHeight="20.0" maxWidth="20.0" minHeight="20.0"
                                   minWidth="20.0" prefHeight="20.0" prefWidth="20.0"
                                   progress="-1.0" visible="false" />
                <Label styleClass="security-note" text="Protected authentication" />
            </HBox>
        </VBox>
        <padding>
            <Insets bottom="48.0" left="64.0" right="64.0" top="48.0" />
        </padding>
    </StackPane>
</GridPane>
