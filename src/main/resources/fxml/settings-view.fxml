<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.SettingsController" minWidth="0" minHeight="0" spacing="12" styleClass="module-root"><fx:define><TableView fx:id="resize" fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></fx:define><Label styleClass="module-heading" text="Settings"/><Label maxWidth="Infinity" wrapText="true" text="Configure business numbering and loyalty behavior. Database credentials remain external and are never managed here."/><FlowPane hgap="8" vgap="8"><TextField fx:id="searchField" prefWidth="280" promptText="Search setting key or description"/><Button onAction="#add" styleClass="primary-action" text="Add setting"/><Button fx:id="editButton" disable="true" onAction="#edit" text="Edit"/><Button onAction="#refresh" text="Refresh"/></FlowPane><Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true"/><TableView fx:id="settingTable" columnResizePolicy="$resize" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="keyColumn" prefWidth="240" text="Setting key"/><TableColumn fx:id="valueColumn" prefWidth="170" text="Value"/><TableColumn fx:id="typeColumn" prefWidth="100" text="Type"/><TableColumn fx:id="descriptionColumn" prefWidth="340" text="Description"/><TableColumn fx:id="updatedColumn" prefWidth="180" text="Last updated"/></columns></TableView><padding><Insets bottom="18" left="18" right="18" top="18"/></padding></VBox>
