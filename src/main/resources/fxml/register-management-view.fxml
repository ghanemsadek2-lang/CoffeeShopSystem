<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.RegisterManagementController" minWidth="0" minHeight="0" styleClass="module-root" stylesheets="@../css/register-management.css">
 <fx:define><TableView fx:id="constrainedResizePolicy" fx:constant="CONSTRAINED_RESIZE_POLICY"/></fx:define>
 <top><VBox spacing="4"><Label styleClass="module-heading" text="Register &amp; Shifts"/><Label maxWidth="Infinity" styleClass="module-subheading" text="Open and reconcile cashier shifts with controlled cash movement history." wrapText="true"/><padding><Insets bottom="10" left="16" right="16" top="14"/></padding></VBox></top>
 <center><TabPane minWidth="0" minHeight="0" tabClosingPolicy="UNAVAILABLE"><tabs>
  <Tab text="Current shift"><VBox minWidth="0" minHeight="0" spacing="10" styleClass="shift-page">
   <GridPane hgap="18" vgap="7" styleClass="current-shift-card"><columnConstraints><ColumnConstraints minWidth="115"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints><Label styleClass="section-label" text="CURRENT SHIFT"/><Label fx:id="shiftStatusLabel" GridPane.columnIndex="1" styleClass="shift-state" text="No open shift"/><Label text="Register" GridPane.rowIndex="1"/><Label fx:id="shiftRegisterLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" text="-"/><Label text="Opened" GridPane.rowIndex="2"/><Label fx:id="shiftOpenedLabel" GridPane.columnIndex="1" GridPane.rowIndex="2" text="-"/><Label text="Opening cash" GridPane.rowIndex="3"/><Label fx:id="shiftOpeningLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" text="0.00"/><Label text="Expected cash" GridPane.rowIndex="4"/><Label fx:id="shiftExpectedLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="expected-cash" text="0.00"/></GridPane>
   <FlowPane hgap="8" vgap="6"><Button fx:id="openShiftButton" onAction="#openShift" text="Open shift" styleClass="primary-action"/><Button fx:id="cashInButton" onAction="#cashIn" text="Cash in"/><Button fx:id="cashOutButton" onAction="#cashOut" text="Cash out"/><Button fx:id="closeShiftButton" onAction="#closeShift" text="Close shift" styleClass="danger-action"/><Button onAction="#refresh" text="Refresh"/></FlowPane>
   <GridPane hgap="8" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columnConstraints><ColumnConstraints minWidth="0" percentWidth="60"/><ColumnConstraints minWidth="0" percentWidth="40"/></columnConstraints><rowConstraints><RowConstraints minHeight="0" vgrow="ALWAYS"/></rowConstraints><VBox maxWidth="Infinity" maxHeight="Infinity" minWidth="0" minHeight="0" spacing="7" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS"><Label styleClass="section-label" text="Shift history"/><TableView fx:id="shiftsTable" columnResizePolicy="$constrainedResizePolicy" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="shiftRegisterColumn" prefWidth="130" text="Register"/><TableColumn fx:id="shiftUserColumn" prefWidth="105" text="User"/><TableColumn fx:id="shiftOpenedColumn" prefWidth="130" text="Opened"/><TableColumn fx:id="shiftStatusColumn" prefWidth="80" text="Status"/><TableColumn fx:id="shiftDifferenceColumn" prefWidth="90" text="Difference"/></columns></TableView></VBox><VBox maxWidth="Infinity" maxHeight="Infinity" minWidth="0" minHeight="0" spacing="7" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS"><Label styleClass="section-label" text="Current cash movements"/><TableView fx:id="movementsTable" columnResizePolicy="$constrainedResizePolicy" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="movementTimeColumn" prefWidth="125" text="Time"/><TableColumn fx:id="movementTypeColumn" prefWidth="85" text="Type"/><TableColumn fx:id="movementAmountColumn" prefWidth="90" text="Amount"/><TableColumn fx:id="movementReasonColumn" prefWidth="180" text="Reason"/></columns></TableView></VBox></GridPane>
  </VBox></Tab>
  <Tab text="Registers"><VBox minWidth="0" minHeight="0" spacing="8" styleClass="shift-page"><FlowPane hgap="8" vgap="6"><Button fx:id="addRegisterButton" onAction="#addRegister" text="Add register" styleClass="primary-action"/><Button fx:id="editRegisterButton" onAction="#editRegister" text="Edit"/><Button fx:id="toggleRegisterButton" onAction="#toggleRegister" text="Deactivate"/></FlowPane><TableView fx:id="registersTable" columnResizePolicy="$constrainedResizePolicy" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="registerCodeColumn" prefWidth="150" text="Code"/><TableColumn fx:id="registerNameColumn" prefWidth="300" text="Register"/><TableColumn fx:id="registerOrderColumn" prefWidth="120" text="Display order"/><TableColumn fx:id="registerStatusColumn" prefWidth="110" text="Status"/></columns></TableView></VBox></Tab>
 </tabs></TabPane></center>
 <bottom><Label fx:id="messageLabel" maxWidth="Infinity" minHeight="30" styleClass="status-message" wrapText="true"><BorderPane.margin><Insets bottom="8" left="16" right="16" top="8"/></BorderPane.margin></Label></bottom>
</BorderPane>
