<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.InventoryManagementController" minWidth="0" minHeight="0" styleClass="module-root" stylesheets="@../css/inventory-management.css">
 <top><VBox spacing="4"><Label styleClass="module-heading" text="Inventory"/><Label maxWidth="Infinity" styleClass="module-subheading" text="Manage ingredients, controlled stock adjustments, and menu recipes." wrapText="true"/><padding><Insets bottom="10" left="16" right="16" top="14"/></padding></VBox></top>
 <center><TabPane minWidth="0" minHeight="0" tabClosingPolicy="UNAVAILABLE"><tabs>
  <Tab text="Stock items"><SplitPane dividerPositions="0.58" minWidth="0" minHeight="0">
   <VBox minWidth="260" minHeight="0" spacing="8" styleClass="inventory-pane"><FlowPane hgap="8" vgap="6"><TextField fx:id="itemSearch" minWidth="150" prefWidth="220" promptText="Search inventory"/><ChoiceBox fx:id="itemStatusFilter" minWidth="105"/><Button onAction="#addItem" text="Add item" styleClass="primary-action"/><Button fx:id="editItemButton" onAction="#editItem" text="Edit"/><Button fx:id="toggleItemButton" onAction="#toggleItem" text="Deactivate"/><Button onAction="#refresh" text="Refresh"/></FlowPane>
    <TableView fx:id="itemsTable" minHeight="0" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="itemCodeColumn" prefWidth="90" text="Code"/><TableColumn fx:id="itemNameColumn" prefWidth="155" text="Item"/><TableColumn fx:id="itemStockColumn" prefWidth="100" text="Stock"/><TableColumn fx:id="itemReorderColumn" prefWidth="90" text="Reorder"/><TableColumn fx:id="itemStatusColumn" prefWidth="75" text="Status"/></columns></TableView></VBox>
   <VBox minWidth="245" minHeight="0" spacing="8" styleClass="inventory-pane"><Label fx:id="selectedItemLabel" styleClass="panel-title" text="Select an inventory item" wrapText="true"/><FlowPane hgap="8" vgap="6"><Button fx:id="stockInButton" onAction="#stockIn" text="Add stock" styleClass="primary-action"/><Button fx:id="stockOutButton" onAction="#stockOut" text="Remove stock"/></FlowPane><Label styleClass="section-label" text="Recent movements"/><TableView fx:id="movementsTable" minHeight="0" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="movementTimeColumn" prefWidth="125" text="Time"/><TableColumn fx:id="movementTypeColumn" prefWidth="90" text="Type"/><TableColumn fx:id="movementQuantityColumn" prefWidth="90" text="Quantity"/><TableColumn fx:id="movementReasonColumn" prefWidth="180" text="Reason"/></columns></TableView></VBox>
  </SplitPane></Tab>
  <Tab text="Product recipes"><BorderPane minWidth="0" minHeight="0"><top><FlowPane hgap="8" vgap="6" styleClass="inventory-toolbar"><Label text="Product variant"/><ComboBox fx:id="variantBox" minWidth="240" prefWidth="340"/><Button fx:id="addRecipeButton" onAction="#addRecipe" text="Add ingredient" styleClass="primary-action"/><Button fx:id="editRecipeButton" onAction="#editRecipe" text="Edit quantity"/><Button fx:id="removeRecipeButton" onAction="#removeRecipe" text="Remove"/></FlowPane></top><center><TableView fx:id="recipesTable" minHeight="0"><columns><TableColumn fx:id="recipeItemColumn" prefWidth="300" text="Inventory ingredient"/><TableColumn fx:id="recipeQuantityColumn" prefWidth="150" text="Quantity required"/><TableColumn fx:id="recipeUnitColumn" prefWidth="150" text="Unit"/></columns></TableView></center></BorderPane></Tab>
  <Tab text="Modifier recipes"><BorderPane minWidth="0" minHeight="0"><top><FlowPane hgap="8" vgap="6" styleClass="inventory-toolbar"><Label text="Modifier"/><ComboBox fx:id="modifierBox" minWidth="240" prefWidth="340"/><Button fx:id="addModifierRecipeButton" onAction="#addModifierRecipe" text="Add ingredient" styleClass="primary-action"/><Button fx:id="editModifierRecipeButton" onAction="#editModifierRecipe" text="Edit quantity"/><Button fx:id="removeModifierRecipeButton" onAction="#removeModifierRecipe" text="Remove"/></FlowPane></top><center><TableView fx:id="modifierRecipesTable" minHeight="0"><columns><TableColumn fx:id="modifierRecipeItemColumn" prefWidth="300" text="Inventory ingredient"/><TableColumn fx:id="modifierRecipeQuantityColumn" prefWidth="150" text="Quantity required"/><TableColumn fx:id="modifierRecipeUnitColumn" prefWidth="150" text="Unit"/></columns></TableView></center></BorderPane></Tab>
 </tabs></TabPane></center>
 <bottom><Label fx:id="messageLabel" maxWidth="Infinity" minHeight="30" styleClass="status-message" wrapText="true"><BorderPane.margin><Insets bottom="8" left="16" right="16" top="8"/></BorderPane.margin></Label></bottom>
</BorderPane>
