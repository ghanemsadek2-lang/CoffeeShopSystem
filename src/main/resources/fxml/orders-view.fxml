<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.OrdersController" minWidth="0" minHeight="0" spacing="12" styleClass="module-root">
 <fx:define><TableView fx:id="constrainedResizePolicy" fx:constant="CONSTRAINED_RESIZE_POLICY"/></fx:define>
 <FlowPane alignment="CENTER_LEFT" hgap="10" vgap="8"><ChoiceBox fx:id="statusFilter" minWidth="120"/><Button onAction="#refresh" text="Refresh"/><Button fx:id="discountButton" disable="true" onAction="#applyDiscount" text="Apply discount"/><Button fx:id="checkoutButton" disable="true" onAction="#checkout" styleClass="primary-action" text="Checkout"/><Button fx:id="cancelButton" disable="true" onAction="#cancel" text="Cancel open order"/></FlowPane>
 <GridPane hgap="2" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columnConstraints><ColumnConstraints minWidth="0" percentWidth="68"/><ColumnConstraints minWidth="0" percentWidth="32"/></columnConstraints><rowConstraints><RowConstraints minHeight="0" vgrow="ALWAYS"/></rowConstraints><TableView fx:id="ordersTable" columnResizePolicy="$constrainedResizePolicy" minWidth="0" minHeight="0" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS"><columns><TableColumn fx:id="numberColumn" prefWidth="120" text="Order"/><TableColumn fx:id="sourceColumn" prefWidth="75" text="Source"/><TableColumn fx:id="typeColumn" prefWidth="95" text="Type"/><TableColumn fx:id="statusColumn" prefWidth="90" text="Status"/><TableColumn fx:id="openedColumn" prefWidth="155" text="Opened"/><TableColumn fx:id="totalColumn" prefWidth="80" text="Total"/><TableColumn fx:id="tableColumn" prefWidth="100" text="Table"/></columns></TableView><VBox maxWidth="Infinity" maxHeight="Infinity" minWidth="0" minHeight="0" spacing="10" styleClass="panel-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS" GridPane.vgrow="ALWAYS"><Label styleClass="panel-title" text="Order details"/><Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true"/><ListView fx:id="detailList" minWidth="0" minHeight="80" VBox.vgrow="ALWAYS"/></VBox></GridPane>
 <padding><Insets bottom="16" left="16" right="16" top="16"/></padding>
</VBox>
