<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.DocumentsController" minWidth="0" minHeight="0" spacing="12" styleClass="module-root">
 <fx:define><TableView fx:id="resize" fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></fx:define>
 <Label styleClass="module-heading" text="Receipts / Invoices"/>
 <Label styleClass="module-subheading" maxWidth="Infinity" wrapText="true" text="Issue immutable customer documents from completed orders and review their stored commercial snapshots."/>
 <FlowPane hgap="8" vgap="8"><ComboBox fx:id="orderBox" prefWidth="250" promptText="Completed order"/><ChoiceBox fx:id="typeBox" prefWidth="130"/><Button onAction="#issue" styleClass="primary-action" text="Issue document"/><Button onAction="#refresh" text="Refresh"/></FlowPane>
 <Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true"/>
 <GridPane hgap="12" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS">
  <columnConstraints><ColumnConstraints percentWidth="68" hgrow="ALWAYS" minWidth="0"/><ColumnConstraints percentWidth="32" hgrow="ALWAYS" minWidth="0"/></columnConstraints>
  <children>
   <TableView fx:id="documentTable" columnResizePolicy="$resize" minWidth="0" minHeight="0" GridPane.hgrow="ALWAYS"><placeholder><VBox styleClass="empty-state"><Label styleClass="empty-state-title" text="No documents issued"/><Label styleClass="empty-state-copy" text="Select a completed order above to issue its first receipt or invoice." wrapText="true"/></VBox></placeholder><columns><TableColumn fx:id="numberColumn" prefWidth="145" text="Document"/><TableColumn fx:id="orderColumn" prefWidth="130" text="Order"/><TableColumn fx:id="typeColumn" prefWidth="100" text="Type"/><TableColumn fx:id="issuedColumn" prefWidth="165" text="Issued"/><TableColumn fx:id="customerColumn" prefWidth="190" text="Customer"/><TableColumn fx:id="totalColumn" prefWidth="100" text="Total"/><TableColumn fx:id="userColumn" prefWidth="110" text="Issued by"/></columns></TableView>
   <VBox minWidth="0" minHeight="0" spacing="7" styleClass="panel-card" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"><Label styleClass="panel-title" text="Document details"/><TextArea fx:id="detailArea" editable="false" minWidth="0" minHeight="0" wrapText="true" VBox.vgrow="ALWAYS"/></VBox>
  </children>
 </GridPane>
 <padding><Insets bottom="18" left="18" right="18" top="18"/></padding>
</VBox>
