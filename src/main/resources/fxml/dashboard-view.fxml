<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.DashboardController" fitToWidth="true" hbarPolicy="NEVER" minWidth="0" minHeight="0" styleClass="transparent-scroll">
 <content><VBox minWidth="0" spacing="20" styleClass="module-root">
  <VBox spacing="5"><Label styleClass="module-heading" text="Good service starts here"/><Label maxWidth="Infinity" styleClass="module-subheading" text="Operational summaries will appear as business data becomes available." wrapText="true"/></VBox>
  <FlowPane hgap="14" vgap="14"><VBox minWidth="180" prefWidth="210" spacing="8" styleClass="metric-card"><Label styleClass="metric-label" text="TODAY'S SALES"/><Label styleClass="metric-empty" text="No snapshot loaded"/></VBox><VBox minWidth="180" prefWidth="210" spacing="8" styleClass="metric-card"><Label styleClass="metric-label" text="TODAY'S ORDERS"/><Label styleClass="metric-empty" text="No snapshot loaded"/></VBox><VBox minWidth="180" prefWidth="210" spacing="8" styleClass="metric-card"><Label styleClass="metric-label" text="ACTIVE TABLES"/><Label styleClass="metric-empty" text="No snapshot loaded"/></VBox><VBox minWidth="180" prefWidth="210" spacing="8" styleClass="metric-card"><Label styleClass="metric-label" text="LOW STOCK"/><Label styleClass="metric-empty" text="No snapshot loaded"/></VBox></FlowPane>
  <FlowPane hgap="16" vgap="16"><VBox minHeight="230" minWidth="280" prefWidth="520" spacing="14" styleClass="panel-card"><Label styleClass="panel-title" text="Recent activity"/><Region VBox.vgrow="ALWAYS"/><Label styleClass="empty-title" text="No recent activity"/><Label maxWidth="Infinity" styleClass="empty-copy" text="Completed and active orders will appear here." wrapText="true"/><Region VBox.vgrow="ALWAYS"/></VBox><VBox minWidth="230" prefWidth="270" spacing="12" styleClass="panel-card"><Label styleClass="panel-title" text="Quick actions"/><Button fx:id="newOrderButton" maxWidth="Infinity" styleClass="primary-action" text="Start new order"/><Button fx:id="viewTablesButton" maxWidth="Infinity" styleClass="secondary-action" text="View tables"/></VBox></FlowPane>
  <padding><Insets bottom="22" left="22" right="22" top="22"/></padding>
 </VBox></content>
</ScrollPane>
