<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.controller.CustomerManagementController" minWidth="0" minHeight="0" spacing="12" styleClass="module-root"><fx:define><TableView fx:id="resize" fx:constant="CONSTRAINED_RESIZE_POLICY"/></fx:define><Label styleClass="module-heading" text="Customers"/><FlowPane hgap="8" vgap="8"><TextField fx:id="searchField" prefWidth="260" promptText="Search name, number, phone or email"/><ChoiceBox fx:id="activeFilter" prefWidth="120"/><Button onAction="#add" styleClass="primary-action" text="Add customer"/><Button fx:id="editButton" disable="true" onAction="#edit" text="Edit"/><Button fx:id="activeButton" disable="true" onAction="#toggle" text="Deactivate"/><Button onAction="#refresh" text="Refresh"/></FlowPane><Label fx:id="messageLabel" maxWidth="Infinity" wrapText="true"/><TableView fx:id="customerTable" columnResizePolicy="$resize" minWidth="0" minHeight="0" VBox.vgrow="ALWAYS"><columns><TableColumn fx:id="numberColumn" prefWidth="125" text="Customer"/><TableColumn fx:id="nameColumn" prefWidth="190" text="Name"/><TableColumn fx:id="phoneColumn" prefWidth="130" text="Phone"/><TableColumn fx:id="emailColumn" prefWidth="210" text="Email"/><TableColumn fx:id="businessColumn" prefWidth="190" text="Business"/><TableColumn fx:id="activeColumn" prefWidth="100" text="Status"/></columns></TableView><padding><Insets bottom="18" left="18" right="18" top="18"/></padding></VBox>
